#include <winres.h>
#include "version.h"

1 ICON "cobalt.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION COBALT_CONNECTOR_VERSION_MAJOR,COBALT_CONNECTOR_VERSION_MINOR,COBALT_CONNECTOR_VERSION_PATCH,0
 PRODUCTVERSION COBALT_CONNECTOR_VERSION_MAJOR,COBALT_CONNECTOR_VERSION_MINOR,COBALT_CONNECTOR_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Cobalt"
            VALUE "FileDescription", "Cobalt Connector"
            VALUE "FileVersion", COBALT_CONNECTOR_VERSION_RC
            VALUE "InternalName", "CobaltConnector"
            VALUE "OriginalFilename", "CobaltConnector.exe"
            VALUE "ProductName", "Cobalt Connector"
            VALUE "ProductVersion", COBALT_CONNECTOR_VERSION_RC
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
